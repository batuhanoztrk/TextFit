<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>netstandard2.1;net9.0</TargetFrameworks>
        <LangVersion>latest</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        
        <RootNamespace>TextFit.Skia</RootNamespace>
        <AssemblyName>TextFit.Skia</AssemblyName>

        <PackageId>TextFit.Skia</PackageId>
        <Version>0.1.0</Version>
        <Authors>batuhanoztrk</Authors>
        <Description>SkiaSharp-based ITextMeasurer for the TextFit library.</Description>
        <PackageTags>text;layout;wrap;autofit;skiasharp</PackageTags>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <RepositoryUrl>https://github.com/batuhanoztrk/TextFit</RepositoryUrl>
        <PackageProjectUrl>https://github.com/batuhanoztrk/TextFit</PackageProjectUrl>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="SkiaSharp" Version="3.119.2"/>
        <ProjectReference Include="..\TextFit\TextFit.csproj"/>
    </ItemGroup>

</Project>
